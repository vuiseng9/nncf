{
    "model": "resnet50",
    "pretrained": true,

    "input_info": {
      "sample_size": [1, 3, 224, 224]
    },
    "num_classes": 1000,
    "batch_size": 150,
    "epochs": 5,
    "multiprocessing_distributed": true,
    "optimizer": {
        "type": "Adam",
        "base_lr": 1e-5
    },
    "compression": 
    [
        {
            "algorithm": "const_sparsity"
        },
        {
            "algorithm": "quantization",
            "initializer": {
                "range": {
                    "num_init_samples": 850
                }
            },
            "params": {
                "base_lr": 2e-5,
                "base_wd": 1e-5,
                "batch_multiplier": 1,
                "activations_quant_start_epoch": 0,
                "weights_quant_start_epoch": 0,
                "lr_poly_drop_start_epoch": 0,
                "lr_poly_drop_duration_epochs": 2,
            }
        }
    ]
}
