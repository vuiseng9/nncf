{
    "model": "mobilenet_v2",
    "pretrained": true,

    "input_info": {
      "sample_size": [1, 3, 224, 224]
    },
    "num_classes": 1000,
    "batch_size": 64,
    "epochs": 1,
    "multiprocessing_distributed": true,
    "optimizer": {
        "type": "Adam",
        "base_lr": 1e-5
    },
    "compression": {
        "algorithm": "quantization",
        "initializer": {
            "range": {
                "num_init_samples": 128
            },
            "batchnorm_adaptation": {
                "num_bn_adaptation_samples": 640
            },
        }
    }
}
