{
    "restful": true,
    "eval_cache": true,
    "quantizer_coupling": false,
    "model": "resnet50",
    "pretrained": true,
    "batch_size" : 240,
    "input_info": {
      "sample_size": [1, 3, 224, 224]
    },
    "target_device": "TRIAL", // We only use TRIAL for NEMO experiments
    "num_classes": 1000,
    "compression": {
        "algorithm": "quantization",
        "weights": {
            "mode": "asymmetric",
            "per_channel": true
        },
        "activations": {
            "mode": "asymmetric",
            "per_channel": true
        },
        "initializer": {
            "batchnorm_adaptation": {
                "num_bn_adaptation_samples": 5000
            },
            "range": {
                "num_init_samples": 5000
            },
            "precision": {
                "type": "autoq",
                "bits": [2, 3, 4, 5, 6, 7, 8],
                "iter_number": 300,
                "compression_ratio": 0.15,
                "eval_subset_ratio": 0.20,
                "dump_init_precision_data": true
            }
        }
    }
}
